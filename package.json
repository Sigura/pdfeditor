{
  "name": "pdf-toolkit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "pnpm --filter @pdf-toolkit/server dev",
    "dev:web": "pnpm --filter @pdf-toolkit/web dev",
    "build": "pnpm --filter @pdf-toolkit/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "tsx fixtures/generate.ts",
    "compare-strategies": "tsx scripts/compare-strategies.mts",
    "pdf-tool": "node --import tsx apps/server/src/cli.ts"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "~1.56.1",
    "@types/node": "^22.10.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "~5.4.296",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
